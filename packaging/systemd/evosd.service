[Unit]
Description=EverythingOS file indexing daemon
Documentation=https://github.com/doriav/everythingos
After=local-fs.target remote-fs.target network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/evosd
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

RuntimeDirectory=evos
RuntimeDirectoryMode=0755
StateDirectory=evos
ConfigurationDirectory=evos

# Indexing is background work.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
LimitNOFILE=65536

# The daemon must stay in the host mount namespace: shares it mounts have
# to be visible to everyone. Options that create a private namespace
# (ProtectSystem=, ProtectHome=, PrivateTmp=, ReadWritePaths=, ...) would
# hide those mounts, so hardening is limited to capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_SYS_RESOURCE CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
